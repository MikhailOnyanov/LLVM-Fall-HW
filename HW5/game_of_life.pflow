// Game of Life on PixelFlow

fun app() {
    GRID_W = 64;
    GRID_H = 64;
    GRID_SIZE = 4096;
    CELL_SIZE = 8;
    WHITE = 16777215;
    BLACK = 0;

    array current[4096];
    array next[4096];

    // init 30% alive
    for y in 0..GRID_H {
        for x in 0..GRID_W {
            idx = y * GRID_W + x;
            random_val = rand() % 100;
            is_alive = random_val < 30;
            current[idx] = is_alive;
        }
    }

    for generation in 0..200 {
        for y in 0..GRID_H {
            for x in 0..GRID_W {
                idx = y * GRID_W + x;
                is_alive = current[idx];

                if (is_alive) {
                    color = WHITE;
                } else {
                    color = BLACK;
                }

                py = y * CELL_SIZE;
                px = x * CELL_SIZE;

                for dy in 0..CELL_SIZE {
                    for dx in 0..CELL_SIZE {
                        pixel_x = px + dx;
                        pixel_y = py + dy;
                        pixel(pixel_x, pixel_y, color);
                    }
                }
            }
        }
        show();

        for y in 0..GRID_H {
            for x in 0..GRID_W {
                idx = y * GRID_W + x;
                cell = current[idx];

                neighbors = 0;
                for dy in -1..2 {
                    for dx in -1..2 {
                        skip = dx == 0;
                        skip2 = dy == 0;
                        both_zero = skip * skip2;

                        if (both_zero == 0) {
                            nx = x + dx;
                            ny = y + dy;

                            valid_x = nx >= 0;
                            valid_x2 = nx < GRID_W;
                            valid_y = ny >= 0;
                            valid_y2 = ny < GRID_H;
                            valid = valid_x * valid_x2 * valid_y * valid_y2;

                            if (valid) {
                                nidx = ny * GRID_W + nx;
                                if (current[nidx]) {
                                    neighbors = neighbors + 1;
                                }
                            }
                        }
                    }
                }

                new_state = 0;
                if (cell) {
                    if (neighbors == 2) {
                        new_state = 1;
                    }
                    if (neighbors == 3) {
                        new_state = 1;
                    }
                } else {
                    if (neighbors == 3) {
                        new_state = 1;
                    }
                }
                next[idx] = new_state;
            }
        }

        for i in 0..GRID_SIZE {
            current[i] = next[i];
        }
    }
}
